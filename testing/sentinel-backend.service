[Unit]
Description=Tested sentinel-backend service :-)

Requires=sentinel-backend.socket
After=sentinel-backend.socket

[Service]
User=services
Group=services

ExecStart=/usr/bin/node /opt/void/sentinel-backend/service.js
WorkingDirectory=/srv/srvcs/sentinel-backend/

Environment=SOCKETMODE=true
Restart=no

[Install]
WantedBy=multi-user.target
